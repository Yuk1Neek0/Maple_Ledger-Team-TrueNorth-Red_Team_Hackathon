# Maple Ledger — environment template.
#
# Copy to `.env` (gitignored) at the repo root for Docker Compose:
#     cp .env.example .env        # then fill in values
# For local (non-Docker) uvicorn, the backend also reads backend/.env.
#
# Everything here is OPTIONAL. With no key the advisory AI features (/draft,
# /ask) return 503 and nothing else is affected; the selectors below all default
# to today's behaviour.

# --- Advisory AI (WS5) ------------------------------------------------------
# Anthropic Claude API key — enables /draft (NL → attestation draft) and /ask
# (NL verifier). Get one at https://console.anthropic.com/. Leave blank to disable.
ANTHROPIC_API_KEY=

# Claude model id for the advisory features (optional).
ML_CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Adapter variant selectors (event-day; see developing/kickoff-checklist.md)
# Defaults reproduce the current mock behaviour. On kickoff, confirm the spec and
# flip the matching value — no code change needed.
# ML_SERIALIZATION=jcs        # jcs | dsse        (canonical serialization)
# ML_ST_STRATEGY=flag         # flag | root | activity   (substantial-transformation rule)
# ML_COST_FLOW=fraction       # fraction | full   (cost-flow / partial-consumption)
