# Copy to `.env.local` to override defaults.

# Base URL of the verifier backend (no trailing slash).
VITE_BACKEND_URL=http://localhost:8000

# Use the hardcoded mock VerificationResult instead of calling the backend.
# Defaults to LIVE (false) — set to "true" only for offline UI work.
# You can also flip this per-page-load with the ?mock=1 / ?mock=0 query param.
VITE_USE_MOCK=false
