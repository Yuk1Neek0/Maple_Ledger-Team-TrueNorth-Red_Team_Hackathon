# Copy to `.env.local` to override defaults.

# Base URL of the verifier backend (no trailing slash).
VITE_BACKEND_URL=http://localhost:8000

# Use the hardcoded mock VerificationResult instead of calling the backend.
# Defaults to mock (true). Set to "false" to call the live backend.
# You can also flip this per-page-load with the ?mock=0 / ?mock=1 query param.
VITE_USE_MOCK=true
